# ==============================================================================
# NEXUS RH — MODÈLE DE CONFIGURATION D'ENVIRONNEMENT (.env.example)
# ==============================================================================
# IMPORTANT : Ne jamais placer de vrais secrets dans ce fichier.
# Copier vers .env en local et utiliser un gestionnaire de secrets en production.

# Environnement d'exécution : development | test | production
NODE_ENV=development

# Profil d'infrastructure :
# - production : exige PostgreSQL + Redis + RabbitMQ + S3 réels et secrets forts (aucun adaptateur sandbox toléré)
# - docker     : utilise les services locaux définis dans infra/docker/docker-compose.yml
# - sandbox    : utilise PGlite (PostgreSQL WASM) et les adaptateurs locaux pour environnement isolé sans Docker
INFRA_PROFILE=docker

# Ports d'écoute (0.0.0.0 requis en conteneur et preview sécurisé)
API_HOST=0.0.0.0
API_PORT=4000
WEB_HOST=0.0.0.0
WEB_PORT=3000
INTERNAL_API_URL=http://127.0.0.1:4000
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Nombre de reverse-proxies de confiance devant l'API (0 = ignorer X-Forwarded-For, utiliser l'IP socket)
TRUSTED_PROXY_COUNT=0

# PostgreSQL 16/17 (requis en profils docker et production)
# DATABASE_MIGRATOR_URL : utilisé uniquement pour exécuter les migrations DDL
# DATABASE_URL          : utilisé par l'application (rôle nexus_app sans SUPERUSER ni BYPASSRLS)
# DATABASE_SSL          : disable (docker local uniquement) | require | verify-full (défaut et obligatoire en production)
# DATABASE_SSL_CA_B64   : certificat CA PEM encodé en base64 (optionnel si CA système de confiance)
DATABASE_MIGRATOR_URL=postgresql://nexus_migrator:CHANGE_ME_STRONG_PASSWORD@localhost:5432/nexus_rh
DATABASE_URL=postgresql://nexus_app:CHANGE_ME_STRONG_PASSWORD@localhost:5432/nexus_rh
DATABASE_SSL=disable
DATABASE_SSL_CA_B64=
PGLITE_DATA_DIR=.data/pglite

# Redis 7 (sessions, révocation JWT, rate limiting, verrous distribués)
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379/0
REDIS_KEY_PREFIX=nexus:dev

# RabbitMQ (messagerie asynchrone + Dead-Letter Queues)
RABBITMQ_URL=amqp://nexus:CHANGE_ME_RABBITMQ_PASSWORD@localhost:5672/nexus_rh

# Stockage documentaire compatible S3 (AWS S3 / Cloudflare R2 / Scaleway / MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-3
S3_BUCKET=nexus-rh-documents
S3_ACCESS_KEY_ID=CHANGE_ME_S3_ACCESS_KEY
S3_SECRET_ACCESS_KEY=CHANGE_ME_S3_SECRET_KEY
S3_FORCE_PATH_STYLE=true
SANDBOX_STORAGE_DIR=.data/object-storage

# Cryptographie & Authentification (OBLIGATOIRES en profils docker et production ;
# aucune génération implicite de clés locales hors profil sandbox)
# Générer MASTER_KEK_HEX avec : openssl rand -hex 32  (64 caractères hex = 256 bits)
MASTER_KEK_HEX=
# Clés Ed25519 encodées en base64 (DER PKCS8 / SPKI) pour signer les Access Tokens JWT
JWT_ED25519_PRIVATE_KEY_B64=
JWT_ED25519_PUBLIC_KEY_B64=
JWT_ISSUER=nexus-rh
JWT_AUDIENCE=nexus-rh-app
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
COOKIE_SECURE=false

# Politique de sécurité & protection anti-saturation mémoire Argon2id (64 MiB/op)
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
ARGON2_MAX_CONCURRENCY=4
ARGON2_MAX_QUEUE=64
MFA_ISSUER_NAME=NEXUS RH
